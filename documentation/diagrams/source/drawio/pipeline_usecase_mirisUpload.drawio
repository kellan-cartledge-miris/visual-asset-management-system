                    <mxGeometry x="2300" y="402" width="536" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="P3zlHuA92NW-nEsySU8p-333" value="Once an asset containing a &lt;u&gt;USD source file (.usd, .usda, .usdc, or .usdz)&lt;/u&gt; is uploaded to the VAMS &lt;b&gt;Amazon S3&lt;/b&gt; asset bucket in an enabled database (or a user clicks &lt;b&gt;Stream with Miris&lt;/b&gt; in the viewer), a VAMS &lt;b&gt;AWS Lambda&lt;/b&gt; execute function is invoked which notifies the downstream pipeline to begin the Miris upload." style="text;whiteSpace=wrap;html=1;" parent="iDfcFz7YVF80BWZX8Eqx-13" vertex="1">
                    <mxGeometry x="36" y="14" width="500" height="65" as="geometry"/>
                </mxCell>
                <mxCell id="P3zlHuA92NW-nEsySU8p-277" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;2&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" parent="iDfcFz7YVF80BWZX8Eqx-13" vertex="1">
                    <mxGeometry y="33" width="25" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="iDfcFz7YVF80BWZX8Eqx-14" value="" style="group" parent="P3zlHuA92NW-nEsySU8p-318" vertex="1" connectable="0">
                    <mxGeometry x="2300" y="499" width="536" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="P3zlHuA92NW-nEsySU8p-280" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;3&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" parent="iDfcFz7YVF80BWZX8Eqx-14" vertex="1">
                    <mxGeometry x="1" y="20" width="25" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="P3zlHuA92NW-nEsySU8p-341" value="The &lt;b&gt;AWS Lambda Miris Upload Gate&lt;/b&gt; enforces the per-database allow-list (&lt;b&gt;enabledDatabaseIds&lt;/b&gt;); it is bypassed for manual UI/CLI invocations. If allowed, the &lt;b&gt;AWS Step Functions State Machine&lt;/b&gt; orchestrates the Miris upload pipeline and &lt;b&gt;AWS Batch&lt;/b&gt; handles scheduling and batch processing of pipeline jobs." style="text;whiteSpace=wrap;html=1;" parent="iDfcFz7YVF80BWZX8Eqx-14" vertex="1">
                    <mxGeometry x="36" width="500" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="iDfcFz7YVF80BWZX8Eqx-15" value="" style="group" parent="P3zlHuA92NW-nEsySU8p-318" vertex="1" connectable="0">
                    <mxGeometry x="2300" y="588" width="536" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="P3zlHuA92NW-nEsySU8p-281" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;4&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" parent="iDfcFz7YVF80BWZX8Eqx-15" vertex="1">
                    <mxGeometry x="1" y="21" width="25" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="P3zlHuA92NW-nEsySU8p-343" value="The &lt;b&gt;AWS Lambda Construct Pipeline&lt;/b&gt; and &lt;b&gt;Open Pipeline&lt;/b&gt; functions build the AWS Batch job definition. &lt;b&gt;AWS Batch (Fargate)&lt;/b&gt; runs the &lt;b&gt;Miris Upload Container&lt;/b&gt; (CPU compute), which downloads the asset folder from S3, resolves USD dependencies, and packages a multi-file USD root into a single &lt;b&gt;.usdz&lt;/b&gt; via OpenUSD. &lt;b&gt;Amazon ECR&lt;/b&gt; stores the container image." style="text;whiteSpace=wrap;html=1;" parent="iDfcFz7YVF80BWZX8Eqx-15" vertex="1">
                    <mxGeometry x="36" width="500" height="66" as="geometry"/>
                </mxCell>
                <mxCell id="iDfcFz7YVF80BWZX8Eqx-16" value="" style="group" parent="P3zlHuA92NW-nEsySU8p-318" vertex="1" connectable="0">
                    <mxGeometry x="2300" y="679" width="537" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="P3zlHuA92NW-nEsySU8p-282" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;5&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" parent="iDfcFz7YVF80BWZX8Eqx-16" vertex="1">
                    <mxGeometry y="22" width="25" height="25" as="geometry"/>
                </mxCell>
                <mxCell id="P3zlHuA92NW-nEsySU8p-331" value="The container reads the &lt;b&gt;Miris Integration Key&lt;/b&gt; from &lt;b&gt;AWS Secrets Manager&lt;/b&gt;, then uploads the prepared asset to the &lt;b&gt;external Miris Spatial Streaming Platform&lt;/b&gt; (Miris content API) over HTTPS via the VPC and Gateway endpoints: POST /v1/content to start, SigV4 S3 PUT to the Miris temp endpoint, then PUT to mark complete. It then polls until Miris reaches a streamable state." style="text;whiteSpace=wrap;html=1;" parent="iDfcFz7YVF80BWZX8Eqx-16" vertex="1">
                    <mxGeometry x="36" width="501" height="92" as="geometry"/>
                </mxCell>
                <mxCell id="iDfcFz7YVF80BWZX8Eqx-17" value="" style="group" parent="P3zlHuA92NW-nEsySU8p-318" vertex="1" connectable="0">
                    <mxGeometry x="2300" y="841" width="536" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="P3zlHuA92NW-nEsySU8p-344" value="On completion, the &lt;b&gt;AWS Lambda Pipeline End&lt;/b&gt; function writes a &lt;b&gt;.mrx manifest&lt;/b&gt; (containing the Miris asset UUID) to the &lt;b&gt;Amazon S3 Asset Bucket&lt;/b&gt; output files path. The VAMS Miris viewer reads this manifest to stream the asset directly from the Miris platform." style="text;whiteSpace=wrap;html=1;" parent="iDfcFz7YVF80BWZX8Eqx-17" vertex="1">
                    <mxGeometry x="36" width="500" height="53" as="geometry"/>
                </mxCell>
                <mxCell id="iDfcFz7YVF80BWZX8Eqx-18" value="" style="group" parent="P3zlHuA92NW-nEsySU8p-318" vertex="1" connectable="0">
                    <mxGeometry x="2300" y="773" width="536" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="OhxrVtxuebdSb0ZAf77U-2" value="The &lt;b&gt;Amazon S3 AuxiliaryAsset Bucket&lt;/b&gt; holds temporary working data during container processing (e.g., the downloaded asset folder and the packaged .usdz). Data in this bucket is unversioned in VAMS and is separate from VAMS versioned assets." style="text;whiteSpace=wrap;html=1;" parent="iDfcFz7YVF80BWZX8Eqx-18" vertex="1">
                    <mxGeometry x="36" width="500" height="78" as="geometry"/>
                </mxCell>
                <mxCell id="MIRIS-title" value="&lt;b&gt;AWS VAMS Miris Auto-Upload Pipeline&lt;/b&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#232F3E;" parent="P3zlHuA92NW-nEsySU8p-318" vertex="1">
                    <mxGeometry x="1260" y="230" width="700" height="40" as="geometry"/>
                </mxCell>
                <mxCell id="P3zlHuA92NW-nEsySU8p-291" value="&lt;font color=&quot;#fcfcfc&quot;&gt;&lt;b&gt;7&lt;/b&gt;&lt;/font&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#66B2FF;" parent="P3zlHuA92NW-nEsySU8p-318" vertex="1">
                    <mxGeometry x="1500" y="1180" width="25" height="25" as="geometry"/>
                </mxCell>
            </root>
        </mxGraphModel>
    </diagram>
</mxfile>