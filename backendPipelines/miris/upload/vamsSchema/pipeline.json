{
    "pipelineName": "Miris Spatial Streaming Upload",
    "category": "Conversion",
    "description": "Packages a USD asset and uploads it to Miris Spatial Streaming, emitting a .mrx manifest so the asset becomes streamable in the VAMS Miris viewer.",
    "executionConfig": {
        "executionType": "Lambda",
        "waitForCallback": "Enabled",
        "taskTimeout": "1800",
        "taskHeartbeatTimeout": "",
        "lambda": {}
    },
    "systemConfig": {
        "inputFileArity": "one",
        "assetScope": { "wholeAsset": false },
        "metadataInputs": {
            "assetMetadata": false,
            "fileMetadata": false,
            "fileAttributes": false
        },
        "requireTemplate": true,
        "allowCustomTemplateOverride": false,
        "inputFileFilters": {
            "allow": ["*.usd", "*.usda", "*.usdc", "*.usdz"],
            "exclude": []
        }
    }
}
